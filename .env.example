# Server-side PostgreSQL connection. Never expose this to the browser.
# Render + Supabase Shared Session Pooler configuration
# Use the project-owned Postgres as the authoritative runtime state source.
DATABASE_URL=postgres://USERNAME:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
PGSSLMODE=require
# Render should supply the official Supabase CA PEM as a secret/env var.
# Do not rely on a system CA file in the container image.
SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n<PASTE_OFFICIAL_SUPABASE_CA_PEM>\n-----END CERTIFICATE-----"

NODE_ENV=production
PORT=10000
APP_BASE_URL=https://your-render-app.onrender.com
APP_ORIGIN=https://your-render-app.onrender.com

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=stored-in-deployment-secrets
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional provider key used only by the AI feature.
GEMINI_API_KEY=stored-in-deployment-secrets
