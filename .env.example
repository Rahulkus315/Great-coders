# Server-side PostgreSQL connection. Set this only in deployment environment variables.
# Keep runtime credentials out of the repo and out of browser-exposed code.
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>?sslmode=require
PGSSLMODE=require

# Render/Supabase CA PEMs must be sourced from deployment secrets, not committed here.
SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n<PASTE_OFFICIAL_SUPABASE_CA_PEM>\n-----END CERTIFICATE-----"

NODE_ENV=production
PORT=10000
APP_BASE_URL=https://your-app.example.com
APP_ORIGIN=https://your-app.example.com

# Password hashes and plaintext passwords must be provided only via deployment secrets.
RAHUL_PASSWORD_HASH=replace-with-bcrypt-hash
DILEEP_PASSWORD_HASH=replace-with-bcrypt-hash
RAHUL_PASSWORD=replace-with-plaintext-password
DILEEP_PASSWORD=replace-with-plaintext-password

# Optional provider key used only by the AI feature.
GEMINI_API_KEY=replace-with-api-key
